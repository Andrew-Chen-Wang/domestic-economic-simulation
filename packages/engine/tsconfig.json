{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
